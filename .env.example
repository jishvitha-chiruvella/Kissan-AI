# KISSAN AI - Environment Variables Example
# Copy to .env in respective directories or configure in your deployment provider.
# NEVER commit real secret keys into this repository.

# Web App (apps/web/.env)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_VISION_API_URL=http://localhost:8000
VITE_CAPTCHA_SITE_KEY=your-captcha-site-key-here
VITE_APP_ENV=development

# Python Vision & ML Service (services/vision-ml/.env)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-or-jwks-url
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
MIN_EVALUATED_FOR_METRICS=10
ML_MIN_SAMPLES=100
PORT=8000

# Supabase Edge Functions Secrets (Set via: supabase secrets set KEY=VALUE)
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-1.5-flash
# CRON_SECRET=your-secure-random-cron-secret
# OPEN_METEO_API_KEY=optional-commercial-key
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
# Note: SUPABASE_SERVICE_ROLE_KEY is auto-injected by Supabase only into the delete-account function.
